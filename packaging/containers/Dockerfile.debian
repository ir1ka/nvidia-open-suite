FROM debian:13
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc-14 g++-14 python3 git python3-yaml debhelper dh-sequence-dkms dkms kmod \
    initramfs-tools libelf-dev libssl-dev pahole patch ca-certificates xz-utils && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1
