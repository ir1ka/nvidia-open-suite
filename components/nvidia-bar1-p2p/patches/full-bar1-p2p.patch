+static NvBool
+_kp2pFullBar1Override(NvU32 gpuMask)
+{
+    NvU32 instance = 0;
+    OBJGPU *first = NULL, *peer;
+    if (gpumgrGetSubDeviceCount(gpuMask) < 2) return NV_FALSE;
+    while ((peer = gpumgrGetNextGpu(gpuMask, &instance)) != NULL)
