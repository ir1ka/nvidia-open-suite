+/* No SKU restriction: physical FB address space, not client-visible/free FB. */
+NvBool
+kbusFullBar1P2PRequested(OBJGPU *pGpu)
+{
+    NvU32 enabled = 0;
+    return pGpu != NULL &&
+        osReadRegistryDword(pGpu, "RMFullBar1P2P", &enabled) == NV_OK && enabled == 1;
+}
+
+NvBool
+kbusFullBar1P2PEligible(OBJGPU *pGpu, KernelBus *pBus)
+{
+    MemoryManager *pMemory;
+    KernelBif *pBif;
+    NvU32 explicitType;
+    NvU64 mb;
+    if (NVCPU_IS_ARM || !kbusFullBar1P2PRequested(pGpu) || pBus == NULL ||
+        IS_VIRTUAL(pGpu) || IS_MIG_ENABLED(pGpu))
+        return NV_FALSE;
+    pBif = GPU_GET_KERNEL_BIF(pGpu);
+    pMemory = GPU_GET_MEMORY_MANAGER(pGpu);
+    if (pMemory == NULL || pBif == NULL ||
+        (pBif->forceP2PType != NV_REG_STR_RM_FORCE_P2P_TYPE_DEFAULT &&
+         pBif->forceP2PType != NV_REG_STR_RM_FORCE_P2P_TYPE_PCIEP2P)) return NV_FALSE;
+    if (osReadRegistryDword(pGpu, NV_REG_STR_RM_PCIEP2P_TYPE, &explicitType) == NV_OK &&
+        explicitType != NV_REG_STR_RM_PCIEP2P_TYPE_BAR1 &&
+        explicitType != NV_REG_STR_RM_PCIEP2P_TYPE_AUTO) return NV_FALSE;
+    mb = pMemory->Ram.fbAddrSpaceSizeMb;
+    if (mb == 0 || mb > (NV_U64_MAX >> 20) ||
+        kbusGetPciBarSize(pBus, 1) < (mb << 20) ||
+        !kbusIsStaticBar1Enabled(pGpu, pBus))
+        return NV_FALSE;
+    return NV_TRUE;
+}
+
+NvBool
+kbusIsPcieBar1P2PMappingSupported_FULLBAR1(OBJGPU *pGpu0, KernelBus *pBus0,
+                                         OBJGPU *pGpu1, KernelBus *pBus1)
+{
+    if (!kbusFullBar1P2PEligible(pGpu0, pBus0) ||
+        !kbusFullBar1P2PEligible(pGpu1, pBus1)) return NV_FALSE;
+    return kbusIsPcieBar1P2PMappingSupported_GH100(pGpu0, pBus0, pGpu1, pBus1);
+}
+
+NV_STATUS
+kbusGetBar1P2PDmaInfo_FULLBAR1(OBJGPU *pSrcGpu, OBJGPU *pPeerGpu,
+                              KernelBus *pPeerBus, NvU64 *pAddress, NvU64 *pSize)
+{
+    if (pSrcGpu == NULL || !kbusFullBar1P2PEligible(pSrcGpu, GPU_GET_KERNEL_BUS(pSrcGpu)) ||
+        !kbusFullBar1P2PEligible(pPeerGpu, pPeerBus)) return NV_ERR_NOT_SUPPORTED;
+    return kbusGetBar1P2PDmaInfo_GH100(pSrcGpu, pPeerGpu, pPeerBus, pAddress, pSize);
+}
+
+NV_STATUS
+kbusCreateP2PMappingForBar1P2P_FULLBAR1(OBJGPU *pGpu0, KernelBus *pBus0,
+                                      OBJGPU *pGpu1, KernelBus *pBus1, NvU32 attributes)
+{
+    if (!kbusFullBar1P2PEligible(pGpu0, pBus0) ||
+        !kbusFullBar1P2PEligible(pGpu1, pBus1)) return NV_ERR_NOT_SUPPORTED;
+    return kbusCreateP2PMappingForBar1P2P_GH100(pGpu0, pBus0, pGpu1, pBus1, attributes);
+}
+
+NvBool
+kbusHasPcieBar1P2PMapping_FULLBAR1(OBJGPU *pGpu0, KernelBus *pBus0,
+                                OBJGPU *pGpu1, KernelBus *pBus1)
