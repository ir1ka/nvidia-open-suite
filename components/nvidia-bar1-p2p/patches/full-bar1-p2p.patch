+        if (first != NULL && !kbusIsPcieBar1P2PMappingSupported_HAL(first,
+                GPU_GET_KERNEL_BUS(first), peer, GPU_GET_KERNEL_BUS(peer))) return NV_FALSE;
+        if (first == NULL) first = peer;
+    }
+    return first != NULL;
