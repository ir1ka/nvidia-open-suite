--- /dev/null
+++ b/src/nvidia/src/kernel/rmapi/nv_gpu_ops_dynamic_bar1.h
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: MIT
+ * Allocation-only dynamic BAR1 P2P, host RM. The caller holds the RM client
+ * and all GPU locks. No lock acquisition/release is hidden in window cleanup.
+ * UVM invalidates PTEs and waits its tracker before freeing the duped handle.
+ */
+typedef struct gpuDynBar1P2PMapping
+{
+    struct gpuDynBar1P2PMapping *pNext;
+    NvHandle hDupMemory;
+    OBJGPU *pMappingGpu;
+    OBJGPU *pRemoteGpu;
+    MEMORY_DESCRIPTOR *pAllocMemDesc;
+    MEMORY_DESCRIPTOR *pWindowMemDesc;
+    MemoryArea memArea;
+    NvU64 size;
+    NvU64 charge;
+    NvBool quarantined;
+    NvU32 iovaspaceId;
+    NvU32 mapFlags;
+    RmPhysAddr windowDmaBase;
+} gpuDynBar1P2PMapping;
+
+static gpuDynBar1P2PMapping *
+_nvGpuOpsDynBar1Find(subDeviceDesc *sub, NvHandle handle)
+{
+    gpuDynBar1P2PMapping *m;
+    for (m = sub->pDynBar1List; m != NULL; m = m->pNext)
+        if (m->hDupMemory == handle) return m;
+    return NULL;
+}
+
+/* Conservative accounting includes 2 MiB rounding per window, across all source
+ * GPUs and clients, even when the aperture allocator reuses an existing window.
+ * This limits dynamic P2P consumption; it does not reserve capacity against NIC
+ * or CPU maps. The actual BAR1 VA allocator is the final fragmentation arbiter.
+ */
+static NV_STATUS
+_nvGpuOpsDynBar1Charge(NvU64 capacity, NvU64 used, NvU64 size, NvU64 *charge)
+{
+    const NvU64 reserve = 64ULL << 20;
+    const NvU64 align = 2ULL << 20;
+    NvU64 rounded;
+    if (size == 0 || size > NV_U64_MAX - (align - 1))
+        return NV_ERR_INVALID_LIMIT;
+    rounded = (size + align - 1) & ~(align - 1);
+    if (capacity <= reserve || rounded > capacity - reserve || used > capacity - reserve - rounded)
+        return NV_ERR_INSUFFICIENT_RESOURCES;
+    *charge = rounded;
+    return NV_OK;
+}
+
+static NV_STATUS
+_nvGpuOpsDynBar1GetOrCreate(subDeviceDesc *sub, OBJGPU *source, OBJGPU *target,
+                            MEMORY_DESCRIPTOR *alloc, NvHandle handle,
+                            RmPhysAddr *dmaBase, NvBool *created)
+{
+    KernelBus *bus = GPU_GET_KERNEL_BUS(target);
+    Bar1VaInfo *bar = &bus->bar1[0];
+    gpuDynBar1P2PMapping *m;
+    NV_STATUS status;
+    NvU64 size = memdescGetSize(alloc), charge = 0, phys;
+    NvU64 capacity = NV_MIN(kbusGetPciBarSize(bus, 1), bar->mappableLength);
+    NvBool apertureMapped = NV_FALSE, iommuMapped = NV_FALSE;
+
+    *created = NV_FALSE;
+    NV_ASSERT_OR_RETURN(rmDeviceGpuLockIsOwner(gpuGetInstance(target)) &&
+                        rmDeviceGpuLockIsOwner(gpuGetInstance(source)), NV_ERR_INVALID_LOCK_STATE);
+    if (!kbusDynamicBar1P2PPair(source, target) || memdescGetAddressSpace(alloc) != ADDR_FBMEM ||
+        alloc->pGpu != target || memdescGetFlag(alloc, MEMDESC_FLAGS_ENCRYPTED) ||
+        memdescGetFlag(alloc, MEMDESC_FLAGS_GPU_PRIVILEGED))
+        return NV_ERR_NOT_SUPPORTED;
+    if (bar->dynamicP2PQuarantined != 0) return NV_ERR_INVALID_STATE;
+    m = _nvGpuOpsDynBar1Find(sub, handle);
+    if (m != NULL)
+    {
+        if (m->pMappingGpu != source || m->pRemoteGpu != target || m->pAllocMemDesc != alloc || m->size != size || m->pWindowMemDesc == NULL)
+            return NV_ERR_INVALID_STATE;
+        *dmaBase = m->windowDmaBase;
+        return NV_OK;
+    }
+    status = _nvGpuOpsDynBar1Charge(capacity, bar->dynamicP2PBytes, size, &charge);
+    if (status != NV_OK) return status;
+    m = portMemAllocNonPaged(sizeof(*m));
+    if (m == NULL) return NV_ERR_NO_MEMORY;
+    portMemSet(m, 0, sizeof(*m));
+    m->pMappingGpu = source;
+    m->pRemoteGpu = target;
+    m->pAllocMemDesc = alloc;
+    m->hDupMemory = handle;
+    m->size = size;
+    m->charge = charge;
+    m->iovaspaceId = source->busInfo.iovaspaceId;
+
+    m->mapFlags = BUS_MAP_FB_FLAGS_MAP_UNICAST | BUS_MAP_FB_FLAGS_ALLOW_RESOURCE_FAILURE;
+    // No ALLOW_DISCONTIG: one contiguous BAR1 VA range; FB may be scattered.
+    status = kbusMapFbAperture_HAL(target, bus, alloc, mrangeMake(0, size),
+                                  &m->memArea, m->mapFlags, NULL);
+    if (status != NV_OK) goto fail;
+    apertureMapped = NV_TRUE;
+    if (m->memArea.numRanges != 1 || m->memArea.pRanges[0].size < size ||
+        m->memArea.pRanges[0].start >= capacity ||
+        size > capacity - m->memArea.pRanges[0].start ||
+        !portSafeAddU64(gpumgrGetGpuPhysFbAddr(target), m->memArea.pRanges[0].start, &phys) ||
+        size - 1 > NV_U64_MAX - phys)
+    {
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+    // Charge any larger range returned by the allocator as well.
+    status = _nvGpuOpsDynBar1Charge(capacity, bar->dynamicP2PBytes,
+                                   m->memArea.pRanges[0].size, &charge);
+    if (status != NV_OK) goto fail;
+    m->charge = charge;
+    // Root memdesc belongs to the target: osIovaMap selects the peer BAR DMA path.
+    status = memdescCreate(&m->pWindowMemDesc, target, size, 0, NV_MEMORY_CONTIGUOUS,
+                           ADDR_SYSMEM, NV_MEMORY_UNCACHED, MEMDESC_FLAGS_NONE);
+    if (status != NV_OK) goto fail;
+    memdescDescribe(m->pWindowMemDesc, ADDR_SYSMEM, phys, size);
+    status = memdescMapIommu(m->pWindowMemDesc, m->iovaspaceId);
+    if (status != NV_OK) goto fail;
+    iommuMapped = NV_TRUE;
+    memdescGetPtePhysAddrsForGpu(m->pWindowMemDesc, source, AT_GPU, 0, 0, 1, &m->windowDmaBase);
+    if (size - 1 > NV_U64_MAX - m->windowDmaBase)
+    {
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+    NV_PRINTF(LEVEL_INFO, "dynamic BAR1 detail page=0x%llx window=0x%llx dma=0x%llx fb=0x%llx\n", memdescGetPageSize(alloc, AT_GPU), m->memArea.pRanges[0].start, m->windowDmaBase, memdescGetPhysAddr(alloc, AT_GPU, 0));
+    // Publish only after the transaction is complete. Zero IOVA is valid.
+    bar->dynamicP2PBytes += charge;
+    m->pNext = sub->pDynBar1List;
+    sub->pDynBar1List = m;
+    *dmaBase = m->windowDmaBase;
+    *created = NV_TRUE;
+    NV_PRINTF(LEVEL_INFO, "dynamic BAR1 P2P map GPU%u->GPU%u handle=0x%x size=0x%llx charge=0x%llx used=0x%llx\n",
+              gpuGetInstance(source), gpuGetInstance(target), handle, size, charge, bar->dynamicP2PBytes);
+    return NV_OK;
+fail:
+    // Same GPU locks are still held, including all failure paths.
+    if (iommuMapped) memdescUnmapIommu(m->pWindowMemDesc, m->iovaspaceId);
+    if (m->pWindowMemDesc != NULL) memdescDestroy(m->pWindowMemDesc);
+    m->pWindowMemDesc = NULL;
+    if (apertureMapped && kbusUnmapFbAperture_HAL(target, bus, alloc, m->memArea,
+            m->mapFlags | BUS_MAP_FB_FLAGS_KEEP_AREA_ON_ERROR) != NV_OK)
+    {
+        m->quarantined = NV_TRUE;
+        bar->dynamicP2PQuarantined++;
+        // Quarantine the failed rollback: retain allocation ownership and budget.
+        // No source DMA mapping remains; handle free/device drain retries unmap.
+        bar->dynamicP2PBytes += m->charge;
+        m->pNext = sub->pDynBar1List;
+        sub->pDynBar1List = m;
+        NV_PRINTF(LEVEL_ERROR, "dynamic BAR1 rollback quarantined handle=0x%x\n", handle);
+        return status;
+    }
+    portMemFree(m);
+    return status;
+}
+
+static NV_STATUS
+_nvGpuOpsDynBar1Destroy(subDeviceDesc *sub, NvHandle handle)
+{
+    gpuDynBar1P2PMapping **link = &sub->pDynBar1List, *m;
+    Bar1VaInfo *bar;
+    NV_STATUS status;
+    while (*link != NULL && (*link)->hDupMemory != handle) link = &(*link)->pNext;
+    if (*link == NULL) return NV_OK;
+    m = *link;
+    // Callers acquire locks before mutation; failed acquisition preserves ownership.
+    if (!rmDeviceGpuLockIsOwner(gpuGetInstance(m->pRemoteGpu)) ||
+        !rmDeviceGpuLockIsOwner(gpuGetInstance(m->pMappingGpu)))
+        return NV_ERR_INVALID_LOCK_STATE;
+    bar = &GPU_GET_KERNEL_BUS(m->pRemoteGpu)->bar1[0];
+    if (m->pWindowMemDesc != NULL) {
+        memdescUnmapIommu(m->pWindowMemDesc, m->iovaspaceId);
+        memdescDestroy(m->pWindowMemDesc);
+        m->pWindowMemDesc = NULL;
+    }
+    status = kbusUnmapFbAperture_HAL(m->pRemoteGpu, GPU_GET_KERNEL_BUS(m->pRemoteGpu),
+                                   m->pAllocMemDesc, m->memArea,
+                                   m->mapFlags | BUS_MAP_FB_FLAGS_KEEP_AREA_ON_ERROR);
+    if (status != NV_OK) {
+        if (!m->quarantined) {
+            m->quarantined = NV_TRUE;
+            bar->dynamicP2PQuarantined++;
+        }
+        NV_PRINTF(LEVEL_ERROR, "dynamic BAR1 unmap quarantined handle=0x%x status=0x%x\n", handle, status);
+        return status;
+    }
+    NV_ASSERT(bar->dynamicP2PBytes >= m->charge);
+    bar->dynamicP2PBytes -= m->charge;
+    if (m->quarantined) bar->dynamicP2PQuarantined--;
+    *link = m->pNext;
+    NV_PRINTF(LEVEL_INFO, "dynamic BAR1 P2P unmap handle=0x%x used=0x%llx\n", handle, bar->dynamicP2PBytes);
+    portMemFree(m);
+    return NV_OK;
+}
+
+static NV_STATUS
+_nvGpuOpsDynBar1Drain(struct gpuDevice *device)
+{
+    nvGpuOpsLockSet locks;
+    THREAD_STATE_NODE thread;
+    NV_STATUS status;
+    subDeviceDesc *sub = device->rmSubDevice;
+    if (sub->pDynBar1List == NULL) return NV_OK;
+    threadStateInit(&thread, THREAD_STATE_FLAGS_NONE);
+    status = _nvGpuOpsLocksAcquireAll(RMAPI_LOCK_FLAGS_READ, device->session->handle, NULL, &locks);
+    if (status == NV_OK)
+    {
+        while (sub->pDynBar1List != NULL) {
+            status = _nvGpuOpsDynBar1Destroy(sub, sub->pDynBar1List->hDupMemory);
+            if (status != NV_OK) break; // No infinite retry under the GPU lock.
+        }
+        _nvGpuOpsLocksRelease(&locks);
+    }
+    // On lock failure the list, budget, handles and subdevice are left intact.
+    threadStateFree(&thread, THREAD_STATE_FLAGS_NONE);
+    return status;
+}
