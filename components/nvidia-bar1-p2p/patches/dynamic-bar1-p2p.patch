+
+/* Opt-in allocation windows: TU102 / Ampere; Ada is an untested preview.
+ * Full BAR1 eligibility remains unchanged. Mixed static/dynamic pairs are rejected.
+ */
+NvBool
+kbusDynamicBar1P2PEligible(OBJGPU *pGpu)
+{
+    NvU32 enabled = 0, explicitType;
+    NvU64 mb, bar;
+    KernelBus *pBus;
+    KernelBif *pBif;
+    MemoryManager *pMemory;
+    if (pGpu == NULL || NVCPU_IS_ARM || IS_VIRTUAL(pGpu) || IS_MIG_ENABLED(pGpu) ||
+        gpuIsCCFeatureEnabled(pGpu) || IsSLIEnabled(pGpu) ||
+        (gpuGetChipArch(pGpu) != GPU_ARCHITECTURE_AMPERE &&
+         gpuGetChipArch(pGpu) != GPU_ARCHITECTURE_ADA &&
+         !(gpuGetChipArch(pGpu) == GPU_ARCHITECTURE_TURING &&
+           gpuGetChipImpl(pGpu) == GPU_IMPLEMENTATION_TU102)) ||
+        osReadRegistryDword(pGpu, "RMDynamicBar1P2P", &enabled) != NV_OK || enabled != 1)
+        return NV_FALSE;
+    pBus = GPU_GET_KERNEL_BUS(pGpu);
+    pBif = GPU_GET_KERNEL_BIF(pGpu);
+    pMemory = GPU_GET_MEMORY_MANAGER(pGpu);
+    if (pBus == NULL || pBif == NULL || pMemory == NULL ||
+        (pBif->forceP2PType != NV_REG_STR_RM_FORCE_P2P_TYPE_DEFAULT &&
+         pBif->forceP2PType != NV_REG_STR_RM_FORCE_P2P_TYPE_PCIEP2P))
+        return NV_FALSE;
+    if (osReadRegistryDword(pGpu, NV_REG_STR_RM_PCIEP2P_TYPE, &explicitType) == NV_OK &&
+        explicitType != NV_REG_STR_RM_PCIEP2P_TYPE_BAR1 &&
+        explicitType != NV_REG_STR_RM_PCIEP2P_TYPE_AUTO)
+        return NV_FALSE;
+    mb = pMemory->Ram.fbAddrSpaceSizeMb;
+    bar = kbusGetPciBarSize(pBus, 1);
+    return mb != 0 && mb <= (NV_U64_MAX >> 20) &&
+        bar > (64ULL << 20) && bar < (mb << 20) &&
+        !kbusIsStaticBar1Enabled(pGpu, pBus) && pBus->bar1[0].pVAS != NULL;
+}
+
+NvBool
+kbusDynamicBar1P2PPair(OBJGPU *a, OBJGPU *b)
+{
+    if (a == b || !kbusDynamicBar1P2PEligible(a) || !kbusDynamicBar1P2PEligible(b))
+        return NV_FALSE;
+    return GPU_GET_KERNEL_BUS(a)->p2pPcie.peerNumberMask[gpuGetInstance(b)] == 0 &&
+           GPU_GET_KERNEL_BUS(b)->p2pPcie.peerNumberMask[gpuGetInstance(a)] == 0;
+}
